# =============================================================================
# EventSphere - environment configuration
# Copy this file to .env and fill in real values before running
# `docker compose up --build`. NEVER commit your actual .env file.
# =============================================================================

# ---------------------------------------------------------------- PostgreSQL
POSTGRES_USER=eventsphere
POSTGRES_PASSWORD=change_me_locally

# --------------------------------------------------------------------- Redis
# (no auth by default for local dev; add REDIS_URL with a password for prod)

# ------------------------------------------------------------------ RabbitMQ
RABBITMQ_USER=eventsphere
RABBITMQ_PASSWORD=change_me_locally

# ----------------------------------------------------------------------- JWT
# Any long random string. All services share this secret to verify tokens
# issued by Identity Service. Generate one with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_string

# ------------------------------------------------------------------ Razorpay
# TEST MODE credentials only. Get these from the Razorpay dashboard:
#   1. Sign up free at https://dashboard.razorpay.com/signup
#   2. Toggle "Test Mode" (top-left switch in the dashboard)
#   3. Settings -> API Keys -> "Generate Test Key"
#   4. Copy the Key Id and Key Secret below
#   5. (optional, for webhook support) Settings -> Webhooks -> Add Webhook
#      -> URL: http://<your-public-url>/api/payments/webhook
#      -> Active events: payment.captured, payment.failed
#      -> copy the generated secret into RAZORPAY_WEBHOOK_SECRET
#
# Test card for checkout: 4111 1111 1111 1111, any future expiry, any CVV,
# any OTP (Razorpay test mode accepts anything in the OTP field).
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_test_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
